# ============================================================
# Global Virtual School (GVS) Mobile App — Environment Template
# Copy this file to .env and fill in real values.
# NEVER commit .env. NEVER put any secret from this file into
# the frontend (public/) — the client only ever talks to our
# own backend routes, which hold these secrets server-side.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth (JWT) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# --- Meta (Facebook) Graph API ---
# GVS Facebook Page ID (public, safe to keep as-is)
PAGE_ID=61592435229097
# Current Graph API version at deployment time, e.g. v21.0
META_GRAPH_VERSION=
# Long-lived Page Access Token issued by the GVS Page admin. NEVER expose to the client.
PAGE_ACCESS_TOKEN=
# App Secret from the Meta App used to verify X-Hub-Signature-256 on webhook events.
META_APP_SECRET=
# Random secret you choose; must match the "Verify Token" configured in the Meta Webhooks console.
WEBHOOK_VERIFY_TOKEN=

# --- AI Teacher ---
# Supported: "anthropic" (Claude), "openai", or "gemini" (Google). Leave AI_PROVIDER
# unset to disable AI Teacher and show the "not yet configured" message instead of failing.
# AI_MODEL is optional -- defaults to claude-sonnet-5 / gpt-4o-mini / gemini-2.0-flash-lite
# respectively. See docs/AI_TEACHER_SETUP.md for provider-specific notes.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Gemini-only override, checked before AI_MODEL -- lets you tune the Gemini
# model (e.g. trade free-tier request quota for a more capable model)
# independently of AI_MODEL. Leave unset to use gemini-2.0-flash-lite.
GEMINI_MODEL=

# --- Persistent data store (Upstash Redis, optional) ---
# server/lib/dataStore.js uses a bundled JSON-file store by default, which
# works fine on a host with one long-running process (local dev, Bonto,
# Render) but does NOT persist reliably on Vercel: separate serverless
# function invocations can run in separate containers with separate,
# non-shared /tmp directories, so a user registered in one container can
# be invisible to a login request served by another ("register succeeds,
# login says invalid credentials"). Setting a REST URL+token pair below
# switches the store to Upstash Redis (via its REST API, so it works from
# a serverless function) automatically, with no code changes needed.
# Provision a free Upstash Redis database from the Vercel Marketplace
# (Storage tab of your Vercel project) and connect it — Vercel injects the
# variables into your project's environment automatically. Which NAMES it
# uses depends on how you connected it, and BOTH are supported here:
#   - UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN — used when
#     connecting directly through Upstash.
#   - KV_REST_API_URL / KV_REST_API_TOKEN — used by Vercel's own
#     "Storage" integration flow, even though the underlying database is
#     a plain Upstash Redis instance. Check your Vercel project's
#     Environment Variables list to see which pair is actually present —
#     don't set both unless you mean to override which database is used.
# Leave all of these unset to keep using the JSON-file store.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Future database migration (optional, not required for this build) ---
# For a relational/document database instead of Redis, populate these and
# wire server/lib/dataStore.js to the chosen backend.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
