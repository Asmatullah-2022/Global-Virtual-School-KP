# ============================================================
# Global Virtual School (GVS) Mobile App — Environment Template
# Copy this file to .env and fill in real values.
# NEVER commit .env. NEVER put any secret from this file into
# the frontend (public/) — the client only ever talks to our
# own backend routes, which hold these secrets server-side.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth (JWT) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# --- Meta (Facebook) Graph API ---
# GVS Facebook Page ID (public, safe to keep as-is)
PAGE_ID=61592435229097
# Current Graph API version at deployment time, e.g. v21.0
META_GRAPH_VERSION=
# Long-lived Page Access Token issued by the GVS Page admin. NEVER expose to the client.
PAGE_ACCESS_TOKEN=
# App Secret from the Meta App used to verify X-Hub-Signature-256 on webhook events.
META_APP_SECRET=
# Random secret you choose; must match the "Verify Token" configured in the Meta Webhooks console.
WEBHOOK_VERIFY_TOKEN=

# --- AI Teacher ---
# Supported: "anthropic" (Claude) or "openai". Leave AI_PROVIDER unset to disable AI Teacher
# and show the "not yet configured" message instead of failing.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- Persistent data store (Upstash Redis, optional) ---
# server/lib/dataStore.js uses a bundled JSON-file store by default, which
# works fine on a host with one long-running process (local dev, Bonto,
# Render) but does NOT persist reliably on Vercel: separate serverless
# function invocations can run in separate containers with separate,
# non-shared /tmp directories, so a user registered in one container can
# be invisible to a login request served by another ("register succeeds,
# login says invalid credentials"). Setting BOTH of the variables below
# switches the store to Upstash Redis (via its REST API, so it works from
# a serverless function) automatically, with no code changes needed.
# Provision a free Upstash Redis database from the Vercel Marketplace
# (Storage tab of your Vercel project) — it injects both variables into
# your Vercel project's environment automatically. Leave both unset to
# keep using the JSON-file store.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Future database migration (optional, not required for this build) ---
# For a relational/document database instead of Redis, populate these and
# wire server/lib/dataStore.js to the chosen backend.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
